{
  "name": "sabura",
  "version": "1.1.1",
  "description": "Portable, offline visual whiteboard in one self-contained HTML file",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "examples:refresh": "node scripts/refresh-examples.js",
    "test:agent-browser": "node scripts/verify-agent-api-e2e.js",
    "test:e2e:chrome": "node scripts/verify-full-e2e.js --chrome-only",
    "test:e2e:render": "node scripts/verify-incremental-render-e2e.js",
    "perf:render": "node scripts/measure-render.js",
    "plugin:build": "node scripts/build-plugin.js",
    "plugin:check": "node scripts/build-plugin.js --check",
    "plugin:zip": "npm run plugin:check && rm -f sabura-plugin.zip && cd plugin && zip -qrX ../sabura-plugin.zip README.md .claude-plugin logo.png logo.svg skills -x \"*.DS_Store\""
  },
  "keywords": [
    "whiteboard",
    "excalidraw",
    "offline",
    "single-file",
    "canvas",
    "agent-api",
    "portable"
  ],
  "author": "Kassem Abdallah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabura-app/sabura-editor.git"
  },
  "bugs": {
    "url": "https://github.com/sabura-app/sabura-editor/issues"
  },
  "homepage": "https://github.com/sabura-app/sabura-editor#readme",
  "devDependencies": {
    "terser": "^5.51.2"
  },
  "bin": {
    "sabura-board": "bin/sabura-board.js"
  }
}
